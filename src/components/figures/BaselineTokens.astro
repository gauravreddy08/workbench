---
// Static figure: tokens made on the server vs SSE events that reach the client.
// The point: chunks are not tokens. Count tokens from usage, time the window from first to last.
---
<svg viewBox="0 0 720 270" role="img" aria-label="The server makes tokens at a steady rhythm. The client receives SSE events that may carry one, two or three tokens each. Tokens per second is computed from the token count and the window between the first and last token, not from the number of events.">
  <defs>
    <marker id="bt-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" class="fill-blue" />
    </marker>
  </defs>

  <!-- lane 1: server -->
  <text x="20" y="34" class="strong">SERVER MAKES TOKENS</text>
  <line x1="20" y1="70" x2="700" y2="70" class="ink" stroke-width="0.8" style="stroke:var(--ink-3)" />
  <g class="blue" stroke-width="1.5">
    <line x1="150" y1="58" x2="150" y2="82" />
    <line x1="190" y1="58" x2="190" y2="82" />
    <line x1="230" y1="58" x2="230" y2="82" />
    <line x1="270" y1="58" x2="270" y2="82" />
    <line x1="310" y1="58" x2="310" y2="82" />
    <line x1="350" y1="58" x2="350" y2="82" />
    <line x1="390" y1="58" x2="390" y2="82" />
    <line x1="430" y1="58" x2="430" y2="82" />
    <line x1="470" y1="58" x2="470" y2="82" />
    <line x1="510" y1="58" x2="510" y2="82" />
    <line x1="550" y1="58" x2="550" y2="82" />
    <line x1="590" y1="58" x2="590" y2="82" />
    <line x1="630" y1="58" x2="630" y2="82" />
  </g>
  <line x1="230" y1="48" x2="270" y2="48" class="ink" stroke-width="1" marker-start="url(#bt-arr)" marker-end="url(#bt-arr)" />
  <text x="250" y="42" text-anchor="middle" class="blue-t">ITL</text>
  <text x="150" y="98" text-anchor="middle">token 1</text>
  <text x="630" y="98" text-anchor="middle">token N</text>

  <!-- leader lines: tokens travel to the client, some bundled -->
  <g class="ink dash" stroke-width="0.7">
    <line x1="150" y1="82" x2="170" y2="140" />
    <line x1="190" y1="82" x2="250" y2="140" />
    <line x1="230" y1="82" x2="250" y2="140" />
    <line x1="270" y1="82" x2="290" y2="140" />
    <line x1="310" y1="82" x2="410" y2="140" />
    <line x1="350" y1="82" x2="410" y2="140" />
    <line x1="390" y1="82" x2="410" y2="140" />
    <line x1="430" y1="82" x2="450" y2="140" />
    <line x1="470" y1="82" x2="530" y2="140" />
    <line x1="510" y1="82" x2="530" y2="140" />
    <line x1="550" y1="82" x2="570" y2="140" />
    <line x1="590" y1="82" x2="610" y2="140" />
    <line x1="630" y1="82" x2="650" y2="140" />
  </g>

  <!-- lane 2: client -->
  <text x="20" y="128" class="strong">CLIENT GETS SSE EVENTS</text>
  <line x1="20" y1="152" x2="700" y2="152" class="ink" stroke-width="0.8" style="stroke:var(--ink-3)" />
  <g stroke-width="1">
    <rect x="162" y="140" width="16" height="24" class="fill-wash" />
    <rect x="240" y="140" width="20" height="24" class="fill-wash" />
    <rect x="282" y="140" width="16" height="24" class="fill-wash" />
    <rect x="398" y="140" width="24" height="24" class="fill-wash" />
    <rect x="442" y="140" width="16" height="24" class="fill-wash" />
    <rect x="520" y="140" width="20" height="24" class="fill-wash" />
    <rect x="562" y="140" width="16" height="24" class="fill-wash" />
    <rect x="602" y="140" width="16" height="24" class="fill-wash" />
    <rect x="642" y="140" width="16" height="24" class="fill-wash" />
  </g>
  <g text-anchor="middle" class="blue-t">
    <text x="170" y="156" class="blue-t">1</text>
    <text x="250" y="156" class="blue-t">2</text>
    <text x="290" y="156" class="blue-t">1</text>
    <text x="410" y="156" class="blue-t">3</text>
    <text x="450" y="156" class="blue-t">1</text>
    <text x="530" y="156" class="blue-t">2</text>
    <text x="570" y="156" class="blue-t">1</text>
    <text x="610" y="156" class="blue-t">1</text>
    <text x="650" y="156" class="blue-t">1</text>
  </g>
  <text x="330" y="182" text-anchor="middle">a stall: 3 tokens arrive at once</text>
  <line x1="372" y1="176" x2="398" y2="162" class="ink" stroke-width="0.8" />

  <!-- time axis and brackets -->
  <line x1="20" y1="206" x2="700" y2="206" class="ink" stroke-width="1" marker-end="url(#bt-arr)" />
  <line x1="20" y1="200" x2="20" y2="212" class="ink" stroke-width="1.2" />
  <text x="20" y="196">send</text>
  <line x1="170" y1="200" x2="170" y2="212" class="ink" stroke-width="1.2" />
  <text x="170" y="196" text-anchor="middle">t_first</text>
  <line x1="650" y1="200" x2="650" y2="212" class="ink" stroke-width="1.2" />
  <text x="650" y="196" text-anchor="middle">t_last</text>

  <path d="M20,222 v6 h150 v-6" class="blue" stroke-width="1.2" />
  <text x="95" y="244" text-anchor="middle" class="blue-t">TTFT</text>
  <path d="M170,222 v6 h480 v-6" class="ink" stroke-width="1.2" />
  <text x="410" y="244" text-anchor="middle" class="strong">TOK/S = (N − 1) / (t_last − t_first)</text>
  <text x="410" y="262" text-anchor="middle">N comes from usage.completion_tokens, not from counting events</text>
</svg>
