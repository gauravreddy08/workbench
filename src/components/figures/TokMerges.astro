---
// Type text, then slide through the first N byte-level BPE merges and watch the bytes fuse into tokens.
// The merge table was learned (1,024 merges, GPT-2 split pattern) from the prose of this site's own lessons.
---
<div class="tokm" data-fig="tok-merges">
  <textarea class="tokm-in" rows="3" aria-label="Text to tokenize" spellcheck="false">The tokenizer doesn't see words. It sees bytes, then merges them.</textarea>
  <div class="ctl tokm-presets">
    <button class="btn" type="button" data-preset="en">English</button>
    <button class="btn" type="button" data-preset="code">Code</button>
    <button class="btn" type="button" data-preset="te">Telugu</button>
    <button class="btn" type="button" data-preset="num">Numbers</button>
    <button class="btn" type="button" data-preset="straw">strawberry</button>
  </div>
  <div class="ctl">
    <label>merges <input type="range" min="0" max="1024" step="1" value="0" data-k aria-label="Number of merges applied" /> <output data-kout>0</output></label>
    <button class="btn" type="button" data-dk="-1" aria-label="One merge fewer">&minus;1</button>
    <button class="btn" type="button" data-dk="1" aria-label="One merge more">+1</button>
    <button class="btn" type="button" data-play aria-pressed="false">Play</button>
  </div>
  <div class="tokm-stats">
    <span>bytes <span class="readout" data-bytes>0</span></span>
    <span>tokens <span class="readout" data-toks>0</span></span>
    <span>bytes/token <span class="readout" data-ratio>1.00</span></span>
    <span>vocab <span class="readout" data-vocab>256</span></span>
  </div>
  <p class="tokm-last" data-last>No merges yet: every byte is its own token.</p>
  <div class="tokm-out" data-out aria-live="polite"></div>
</div>

<style>
  .tokm-in {
    display: block; width: 100%; font-family: var(--mono); font-size: 13.5px; line-height: 1.5;
    background: var(--paper); color: var(--ink); border: 1px solid var(--rule); padding: 10px 12px; resize: vertical;
  }
  .tokm-in:focus { outline: 2px solid var(--blue); outline-offset: -1px; }
  .tokm-presets { margin-top: 10px; gap: 8px; }
  .tokm-presets .btn { padding: 5px 9px; font-size: 10.5px; }
  .tokm-stats { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 14px; font-family: var(--mono); font-size: 12px; color: var(--ink-2); }
  .tokm-last { font-family: var(--mono); font-size: 12px; color: var(--ink-2); margin: 10px 0 0; min-height: 1.5em; overflow-wrap: anywhere; }
  .tokm-out { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 12px; font-family: var(--mono); font-size: 13px; line-height: 1.2; }
  .tokm-out span {
    display: inline-block; max-width: 100%; padding: 3px 4px; border: 1px solid var(--rule); white-space: pre-wrap; word-break: break-all; color: var(--ink);
  }
  .tokm-out .a { background: var(--blue-fill); border-color: var(--blue-2); }
  .tokm-out .b { background: var(--paper-2); }
  .tokm-out .raw { font-size: 10.5px; color: var(--ink-2); }
  .tokm-out .new { background: var(--blue); color: var(--paper); border-color: var(--blue); }
  .tokm-out .br { flex-basis: 100%; height: 0; padding: 0; border: 0; }
</style>

