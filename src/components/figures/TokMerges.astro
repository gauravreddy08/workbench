;
  const vocab: Uint8Array[] = [];
  for (let i = 0; i < 256; i++) vocab.push(new Uint8Array([i]));
  const rank = new Map<number, number>();
  M.forEach(([a, b], k) => {
    const v = new Uint8Array(vocab[a].length + vocab[b].length);
    v.set(vocab[a]); v.set(vocab[b], vocab[a].length);
    vocab.push(v);
    rank.set(a * 4096 + b, k);
  });
  // GPT-2's pre-tokenization pattern: split into word-ish chunks first; merges never cross chunks.
  const PAT = /'(?:[sdmt]|ll|ve|re)| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+(?!\S)|\s+/gu;
  const enc = new TextEncoder();
  const dec = new TextDecoder('utf-8', { fatal: true });
  const PRESETS: Record<string, string> = {
    en: "The tokenizer doesn't see words. It sees bytes, then merges them.",
    code: 'def scale(xs, k):\n    for i in range(len(xs)):\n        xs[i] = xs[i] * k\n    return xs',
    te: 'ఈ రోజు వాతావరణం చాలా బాగుంది',
    num: 'In 2026 the bill was $1,234,567.89 for 98765 tokens.',
    straw: 'How many r letters are in strawberry? s t r a w b e r r y',
  };

  function encodeChunk(bytes: Uint8Array, k: number): number[] {
    let ids = Array.from(bytes);
    while (ids.length > 1) {
      let best = -1, bestR = Infinity;
      for (let i = 0; i < ids.length - 1; i++) {
        const r = rank.get(ids[i] * 4096 + ids[i + 1]);
        if (r !== undefined && r < k && r < bestR) { bestR = r; best = i; }
      }
      if (best < 0) break;
      const a = ids[best], b = ids[best + 1], out: number[] = [];
      for (let i = 0; i < ids.length; i++) {
        if (i < ids.length - 1 && ids[i] === a && ids[i + 1] === b) { out.push(256 + bestR); i++; }
        else out.push(ids[i]);
      }
      ids = out;
    }
    return ids;
  }

  function show(id: number): { text: string; raw: boolean } {
    try {
      const s = dec.decode(vocab[id]);
      return { text: s.replace(/ /g, '·').replace(/\n/g, '↵').replace(/\t/g, '→'), raw: false };
    } catch {
      // Not a whole character: part of a multi-byte UTF-8 sequence. Show the raw bytes.
      return { text: Array.from(vocab[id], (x) => x.toString(16).toUpperCase().padStart(2, '0')).join(' '), raw: true };
    }
  }

  document.querySelectorAll<HTMLElement>('[data-fig="tok-merges"]').forEach((root) => {
    const ta = root.querySelector<HTMLTextAreaElement>('textarea')!;
    const kIn = root.querySelector<HTMLInputElement>('[data-k]')!;
    const kOut = root.querySelector<HTMLOutputElement>('[data-kout]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const last = root.querySelector<HTMLElement>('[data-last]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    let timer: number | undefined;

    function render() {
      const k = +kIn.value;
      kOut.textContent = String(k);
      const text = ta.value;
      const nBytes = enc.encode(text).length;
      const frag = document.createDocumentFragment();
      let n = 0;
      for (const m of text.matchAll(PAT)) {
        for (const id of encodeChunk(enc.encode(m[0]), k)) {
          const { text: t, raw } = show(id);
          const el = document.createElement('span');
          el.textContent = t;
          el.className = (n % 2 ? 'b' : 'a') + (raw ? ' raw' : '') + (k > 0 && id === 255 + k ? ' new' : '');
          el.title = `token id ${id}, ${vocab[id].length} byte${vocab[id].length > 1 ? 's' : ''}`;
          frag.appendChild(el);
          n++;
          if (!raw && t.endsWith('↵')) { const br = document.createElement('span'); br.className = 'br'; frag.appendChild(br); }
        }
      }
      out.replaceChildren(frag);
      q('[data-bytes]').textContent = String(nBytes);
      q('[data-toks]').textContent = String(n);
      q('[data-ratio]').textContent = n ? (nBytes / n).toFixed(2) : '0.00';
      q('[data-vocab]').textContent = String(256 + k);
      if (k === 0) last.textContent = 'No merges yet: every byte is its own token.';
      else {
        const [a, b] = M[k - 1];
        last.textContent = `merge #${k}: [${show(a).text}] + [${show(b).text}] → [${show(255 + k).text}]  (new token id ${255 + k})`;
      }
    }

    function stop() { if (timer) clearInterval(timer); timer = undefined; playBtn.setAttribute('aria-pressed', 'false'); playBtn.textContent = 'Play'; }
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (+kIn.value >= 1024) kIn.value = '0';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { kIn.value = '1024'; render(); return; }
      playBtn.setAttribute('aria-pressed', 'true'); playBtn.textContent = 'Pause';
      timer = window.setInterval(() => {
        const k = +kIn.value;
        const step = k < 64 ? 1 : k < 256 ? 4 : 16;
        kIn.value = String(Math.min(1024, k + step));
        render();
        if (+kIn.value >= 1024) stop();
      }, 90);
    });
    kIn.addEventListener('input', () => { stop(); render(); });
    ta.addEventListener('input', render);
    root.querySelectorAll<HTMLButtonElement>('[data-dk]').forEach((b) => b.addEventListener('click', () => {
      stop();
      kIn.value = String(Math.max(0, Math.min(1024, +kIn.value + +b.dataset.dk!)));
      render();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      ta.value = PRESETS[b.dataset.preset!]; render();
    }));
    render();
  });
</script>
