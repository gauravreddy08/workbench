---
// CPU/GPU timeline for an 8-op elementwise chain (a hand-written GELU) in PyTorch eager,
// eager replayed as a CUDA graph, and torch.compile (one fused kernel). Slider sets tensor size.
// Illustrative model, not a measurement: see the constants below and the note under the figure.
// Usage: <PySpeedLaunch />
---
<div class="pl" data-fig="pyspeed-launch">
  <div class="pl-modes" role="group" aria-label="Execution mode">
    <button class="btn" type="button" data-mode="eager" aria-pressed="true">Eager</button>
    <button class="btn" type="button" data-mode="graph" aria-pressed="false">Eager + CUDA graph</button>
    <button class="btn" type="button" data-mode="fused" aria-pressed="false">torch.compile (fused)</button>
  </div>
  <svg viewBox="0 0 560 150" role="img" aria-label="Timeline: CPU launching work on top, GPU running kernels below">
    <text x="10" y="48" class="strong">CPU</text>
    <text x="10" y="98" class="strong">GPU</text>
    <line x1="70" y1="30" x2="70" y2="125" class="ink" stroke-width="1" />
    <line x1="70" y1="125" x2="550" y2="125" class="ink" stroke-width="1" />
    <g data-layer="cpu"></g>
    <g data-layer="gpu"></g>
    <text x="70" y="141">0</text>
    <text x="550" y="141" text-anchor="end" data-axis>-</text>
  </svg>
  <div class="ctl">
    <label>elements per tensor <input type="range" min="10" max="26" step="1" value="14" data-in="n" /> <output data-o="n">-</output></label>
  </div>
  <div class="ctl">
    <span>total <output data-o="total">-</output></span>
    <span>GPU busy <output data-o="busy">-</output></span>
    <span>bound by <output data-o="bound">-</output></span>
  </div>
</div>

<style>
  .pl-modes { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .pl svg { width: 100%; }
  .pl svg rect.pl-cpu { fill: var(--paper-2); stroke: var(--ink); }
  .pl svg rect.pl-gpu { fill: var(--blue-fill); stroke: var(--blue); }
</style>

<script>
  // Model constants (rough, order-of-magnitude; see lesson text).
  const OPS = 8;            // ops in the hand-written GELU chain
  const EAGER_CPU = 8;      // µs of Python + dispatcher + launch per eager op
  const GRAPH_CPU = 5;      // µs to launch a whole captured CUDA graph
  const GRAPH_GAP = 1;      // µs between kernels inside a graph
  const FUSED_CPU = 15;     // µs for compiled wrapper: guards + one launch
  const KMIN = 3;           // µs, smallest useful kernel duration
  const BW = 273e9;         // bytes/s, DGX Spark spec-sheet memory bandwidth

  type Box = { t0: number; t1: number };

  function model(mode: string, n: number) {
    const kern = Math.max(KMIN, (8 * n) / BW * 1e6); // read 4 B + write 4 B per element
    const cpu: Box[] = [];
    const gpu: Box[] = [];
    if (mode === 'eager') {
      let free = 0;
      for (let i = 0; i < OPS; i++) {
        const issued = (i + 1) * EAGER_CPU;
        cpu.push({ t0: i * EAGER_CPU, t1: issued });
        const s = Math.max(issued, free);
        gpu.push({ t0: s, t1: s + kern });
        free = s + kern;
      }
    } else if (mode === 'graph') {
      cpu.push({ t0: 0, t1: GRAPH_CPU });
      let t = GRAPH_CPU;
      for (let i = 0; i < OPS; i++) { gpu.push({ t0: t, t1: t + kern }); t += kern + GRAPH_GAP; }
    } else {
      cpu.push({ t0: 0, t1: FUSED_CPU });
      gpu.push({ t0: FUSED_CPU, t1: FUSED_CPU + kern });
    }
    const total = gpu[gpu.length - 1].t1;
    const busy = gpu.reduce((a, b) => a + (b.t1 - b.t0), 0) / total;
    return { cpu, gpu, total, busy, kern };
  }

  const fmtT = (us: number) => (us >= 1000 ? `${(us / 1000).toFixed(2)} ms` : `${us.toFixed(us < 10 ? 1 : 0)} µs`);
  const fmtN = (n: number) => {
    const units = ['', 'K', 'M'];
    let v = n, u = 0;
    while (v >= 1024 && u < 2) { v /= 1024; u++; }
    const mb = (n * 4) / 2 ** 20;
    return `${v}${units[u]} (${mb >= 1 ? mb.toFixed(0) + ' MB' : (n * 4 / 1024).toFixed(0) + ' KB'})`;
  };

  document.querySelectorAll<HTMLElement>('[data-fig="pyspeed-launch"]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-in="n"]')!;
    const cpuL = root.querySelector('[data-layer="cpu"]')!;
    const gpuL = root.querySelector('[data-layer="gpu"]')!;
    const axis = root.querySelector('[data-axis]')!;
    const out = (k: string) => root.querySelector<HTMLOutputElement>(`[data-o="${k}"]`)!;
    let mode = 'eager';
    const NS = 'http://www.w3.org/2000/svg';

    function rects(layer: Element, boxes: Box[], y: number, cls: string, scale: number) {
      layer.replaceChildren(...boxes.map((b) => {
        const r = document.createElementNS(NS, 'rect');
        const x = 70 + b.t0 * scale;
        r.setAttribute('x', x.toFixed(2));
        r.setAttribute('y', String(y));
        r.setAttribute('width', Math.max(0.8, (b.t1 - b.t0) * scale - 0.6).toFixed(2));
        r.setAttribute('height', '28');
        r.setAttribute('class', cls);
        r.setAttribute('stroke-width', '1');
        return r;
      }));
    }

    function render() {
      const n = 2 ** +input.value;
      const all = ['eager', 'graph', 'fused'].map((m) => model(m, n).total);
      const span = Math.max(...all);
      const scale = 480 / span;
      const m = model(mode, n);
      rects(cpuL, m.cpu, 30, 'pl-cpu', scale);
      rects(gpuL, m.gpu, 80, 'pl-gpu', scale);
      axis.textContent = fmtT(span);
      out('n').textContent = fmtN(n);
      out('total').textContent = fmtT(m.total);
      out('busy').textContent = `${Math.round(m.busy * 100)}%`;
      out('bound').textContent = m.busy < 0.5 ? 'CPU overhead' : m.kern > KMIN ? 'memory bandwidth' : 'kernel minimum';
    }

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode!;
      root.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }));
    input.addEventListener('input', render);
    render();
  });
</script>
