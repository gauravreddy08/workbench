---
// Big-bang vs continuous integration on the SAME stream of edits.
// A toy model: each developer edits `size` files per day for 40 days, picked with a skew toward
// a few hot files (config, shared utils). Edits are merged into trunk either every B days (big bang)
// or every day (continuous). At each merge, any file touched by two or more developers since the
// last merge is a conflict; the "edits to reconcile" is every edit to such a file in that window.
// Each edit has a small chance of carrying a bug, which nobody sees until the next merge runs the tests.
---
<div class="pint" data-fig="pipeline-integration">
  <svg viewBox="0 0 520 330" role="img" aria-label="Two timelines of developer branches: merging rarely versus merging every day, with conflicts and bug lifetimes marked"></svg>
  <div class="ctl">
    <label>Developers <input type="range" min="1" max="12" value="6" data-k="n" /> <output data-o="n">6</output></label>
    <label>Files edited / dev / day <input type="range" min="1" max="10" value="3" data-k="size" /> <output data-o="size">3</output></label>
    <label>Big-bang merge every <input type="range" min="2" max="40" value="20" data-k="b" /> <output data-o="b">20</output> days</label>
  </div>
  <table class="pint-t">
    <thead><tr><th></th><th>Conflicting files</th><th>Edits to reconcile</th><th>Bugs</th><th>Avg bug age</th><th>Bug-days</th></tr></thead>
    <tbody>
      <tr><td>Big bang</td><td class="readout" data-r="bcf">-</td><td class="readout" data-r="bcw">-</td><td class="readout" data-r="bb">-</td><td class="readout" data-r="bage">-</td><td class="readout" data-r="bbd">-</td></tr>
      <tr><td>Continuous</td><td class="readout" data-r="ccf">-</td><td class="readout" data-r="ccw">-</td><td class="readout" data-r="cb">-</td><td class="readout" data-r="cage">-</td><td class="readout" data-r="cbd">-</td></tr>
    </tbody>
  </table>
  <p class="pint-why" data-r="why"></p>
</div>

<style>
  .pint .ctl label { flex-wrap: wrap; }
  .pint .ctl input[type='range'] { max-width: 100%; }
  .pint-t { font-family: var(--mono); font-size: 12px !important; margin: 14px 0 0 !important; }
  .pint-t th { font-size: 10px !important; white-space: normal !important; }
  .pint-t td { padding: 6px 10px 6px 0 !important; }
  .pint-why { font-family: var(--mono); font-size: 12px; color: var(--ink-2); margin: 10px 0 0; line-height: 1.6; }
</style>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const D = 40; // working days shown
  const F = 600; // files in the repo
  const P_BUG = 0.02; // chance an edit carries a bug

  function rng(seed: number) {
    // mulberry32: small deterministic PRNG so the picture doesn't jitter between renders
    return () => {
      seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  type Edit = { dev: number; day: number; file: number; bug: boolean };

  function makeEdits(n: number, size: number): Edit[] {
    // one random stream per developer, so adding a developer doesn't reshuffle the others
    const out: Edit[] = [];
    for (let dev = 0; dev < n; dev++) {
      const r = rng(1000 + dev * 7919);
      for (let day = 0; day < D; day++) {
        for (let k = 0; k < 10; k++) {
          const file = Math.floor(F * r() * r()); // skewed toward low ids: a few hot files
          const bug = r() < P_BUG;
          if (k < size) out.push({ dev, day, file, bug });
        }
      }
    }
    return out;
  }

  function evaluate(edits: Edit[], every: number) {
    const windows: { s: number; e: number; cw: number }[] = [];
    let cf = 0, cw = 0, bugs = 0, bugDays = 0;
    const bugLines: { dev: number; from: number; to: number }[] = [];
    for (let s = 0; s < D; s += every) {
      const e = Math.min(D, s + every);
      const touch = new Map<number, Map<number, number>>();
      for (const x of edits) {
        if (x.day < s || x.day >= e) continue;
        let m = touch.get(x.file);
        if (!m) { m = new Map(); touch.set(x.file, m); }
        m.set(x.dev, (m.get(x.dev) ?? 0) + 1);
        if (x.bug) {
          bugs++;
          const age = e - (x.day + 0.5); // found when the merge at day e runs the tests
          bugDays += age;
          bugLines.push({ dev: x.dev, from: x.day + 0.5, to: e });
        }
      }
      let wcw = 0;
      touch.forEach((m) => {
        if (m.size >= 2) { cf++; let t = 0; m.forEach((v) => (t += v)); wcw += t; }
      });
      cw += wcw;
      windows.push({ s, e, cw: wcw });
    }
    return { windows, cf, cw, bugs, bugDays, bugLines };
  }

  function el(tag: string, attrs: Record<string, string | number>, text?: string) {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  document.querySelectorAll<HTMLElement>('[data-fig="pipeline-integration"]').forEach((root) => {
    const svg = root.querySelector('svg')!;
    const s = { n: 6, size: 3, b: 20 };
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;

    function panel(y0: number, title: string, res: ReturnType<typeof evaluate>, n: number, maxCw: number) {
      const X0 = 36, X1 = 512;
      const x = (d: number) => X0 + (d / D) * (X1 - X0);
      const laneH = Math.min(10, 96 / n), gap = Math.min(3, laneH * 0.3);
      const top = y0 + 30;
      svg.append(el('text', { x: 0, y: y0 + 10, class: 'strong' }, title));
      // trunk
      svg.append(el('line', { x1: X0, y1: y0 + 20, x2: X1, y2: y0 + 20, class: 'ink', 'stroke-width': 1.5 }));
      svg.append(el('text', { x: 0, y: y0 + 24 }, 'MAIN'));
      for (let dev = 0; dev < n; dev++) {
        const y = top + dev * (laneH + gap);
        if (n <= 8) svg.append(el('text', { x: 0, y: y + laneH - 1, 'font-size': 9 }, `D${dev + 1}`));
        for (const w of res.windows) {
          svg.append(el('rect', { x: x(w.s) + 0.4, y, width: Math.max(x(w.e) - x(w.s) - 0.8, 0.6), height: laneH, class: 'fill-wash', 'stroke-width': 0.6 }));
        }
      }
      const bottom = top + n * (laneH + gap);
      // merges: a tick on main per merge, a circle sized by conflict work
      for (const w of res.windows) {
        svg.append(el('line', { x1: x(w.e), y1: y0 + 16, x2: x(w.e), y2: y0 + 24, class: 'ink', 'stroke-width': 1 }));
        if (w.cw > 0) {
          const rad = 1.5 + 9 * Math.sqrt(w.cw / Math.max(maxCw, 1));
          svg.append(el('circle', { cx: x(w.e), cy: y0 + 20, r: rad, style: 'fill:var(--warn);opacity:0.75' }));
        }
      }
      // bugs: a line from where the bug was written to where a merge's tests catch it
      for (const b of res.bugLines) {
        const y = top + b.dev * (laneH + gap) + laneH / 2;
        svg.append(el('line', { x1: x(b.from), y1: y, x2: x(b.to), y2: y, style: 'stroke:var(--warn)', 'stroke-width': 1.5 }));
        svg.append(el('circle', { cx: x(b.from), cy: y, r: 1.8, style: 'fill:var(--warn)' }));
      }
      return bottom;
    }

    function draw() {
      const edits = makeEdits(s.n, s.size);
      const big = evaluate(edits, s.b);
      const ci = evaluate(edits, 1);
      const maxCw = Math.max(...big.windows.map((w) => w.cw), ...ci.windows.map((w) => w.cw), 1);
      svg.replaceChildren();
      const b1 = panel(0, `BIG BANG · MERGE EVERY ${s.b} DAYS`, big, s.n, maxCw);
      const b2 = panel(b1 + 18, 'CONTINUOUS · MERGE EVERY DAY', ci, s.n, maxCw);
      const X0 = 36, X1 = 512;
      const ay = b2 + 16;
      for (let d = 0; d <= D; d += 10) {
        const xx = X0 + (d / D) * (X1 - X0);
        svg.append(el('text', { x: xx, y: ay, 'text-anchor': 'middle' }, `${d}`));
      }
      svg.append(el('text', { x: X1, y: ay + 14, 'text-anchor': 'end' }, 'WORKING DAYS'));
      const ly = ay + 14;
      svg.append(el('circle', { cx: 4, cy: ly - 4, r: 4, style: 'fill:var(--warn);opacity:0.75' }));
      svg.append(el('text', { x: 12, y: ly }, 'CONFLICTS AT MERGE'));
      svg.append(el('line', { x1: 150, y1: ly - 4, x2: 168, y2: ly - 4, style: 'stroke:var(--warn)', 'stroke-width': 1.5 }));
      svg.append(el('text', { x: 174, y: ly }, 'BUG ALIVE, UNSEEN'));
      svg.setAttribute('viewBox', `0 0 520 ${ly + 6}`);

      r('bcf').textContent = String(big.cf);
      r('ccf').textContent = String(ci.cf);
      r('bcw').textContent = String(big.cw);
      r('ccw').textContent = String(ci.cw);
      r('bb').textContent = String(big.bugs);
      r('cb').textContent = String(ci.bugs);
      r('bage').textContent = big.bugs ? (big.bugDays / big.bugs).toFixed(1) + ' d' : '-';
      r('cage').textContent = ci.bugs ? (ci.bugDays / ci.bugs).toFixed(1) + ' d' : '-';
      r('bbd').textContent = big.bugDays.toFixed(0);
      r('cbd').textContent = ci.bugDays.toFixed(0);

      let why = '';
      if (s.n === 1) why = 'One developer never conflicts with anyone. Integration pain is a team problem. Bugs still hide until tests run.';
      else if (s.b <= 2) why = 'Merging every couple of days is already close to continuous. The gap opens as branches live longer.';
      else {
        const ratio = ci.cw ? big.cw / ci.cw : Infinity;
        why = `Same edits, same bugs. Merging every ${s.b} days means ${isFinite(ratio) ? ratio.toFixed(1) + 'x' : 'far'} more edits to reconcile, and each bug lives about ${(s.b / 2).toFixed(0)} days instead of half a day.`;
      }
      r('why').textContent = why;
    }

    root.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((inp) => {
      inp.addEventListener('input', () => {
        (s as any)[inp.dataset.k!] = +inp.value;
        root.querySelector<HTMLElement>(`[data-o="${inp.dataset.k}"]`)!.textContent = inp.value;
        draw();
      });
    });
    draw();
  });
</script>
