---
// Toy isoFLOP explorer. Two variants follow a Chinchilla-style loss law
// L(N, D) = E + A / (m*N)^alpha + B / D^beta, with Chinchilla's published fit constants.
// Variant A is the baseline (m = 1, 6N FLOPs per token). Variant B gets a "quality per
// parameter" multiplier m and a "FLOPs per parameter" multiplier k (it costs 6kN per token).
// Compare them at equal params (same N, same tokens) and at equal FLOPs (each at its best N).
// Usage: <ArchIsoFlop />
---
<div class="aif" data-fig="arch-isoflop">
  <svg viewBox="0 0 560 330" role="img" aria-label="Loss against model size at several fixed compute budgets, for two variants">
    <g data-layer="axes"></g>
    <g data-layer="curves"></g>
    <g data-layer="marks"></g>
  </svg>
  <div class="ctl">
    <label>budget <input type="range" min="0" max="3" step="1" value="1" data-in="c" /> <output data-out="c">1e19</output></label>
  </div>
  <div class="ctl">
    <label>quality <input type="range" min="0.6" max="1.8" step="0.05" value="1.3" data-in="m" /> <output data-out="m">1.30x</output></label>
  </div>
  <div class="ctl">
    <label>cost <input type="range" min="0.5" max="2.5" step="0.1" value="1.5" data-in="k" /> <output data-out="k">1.5x</output></label>
  </div>
  <div class="ctl">
    <span>presets</span>
    <button class="btn" type="button" data-p="1.3,1.5">Costly + strong</button>
    <button class="btn" type="button" data-p="0.9,0.8">Cheap + weak</button>
    <button class="btn" type="button" data-p="1,1">Identical</button>
  </div>
  <div class="aif-out">
    <div><span class="label">Equal params + tokens</span><span data-out="eqp">-</span></div>
    <div><span class="label">Equal FLOPs, each tuned</span><span data-out="eqf">-</span></div>
    <div><span class="label">B worth, in A's compute</span><span class="readout" data-out="mult">-</span></div>
  </div>
</div>

<style>
  .aif svg { width: 100%; }
  .aif-out { margin-top: 14px; display: grid; gap: 8px; font-family: var(--mono); font-size: 12px; color: var(--ink-2); }
  .aif-out > div { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; border-top: 1px solid var(--rule); padding-top: 6px; }
  .aif-out .label { min-width: 170px; }
  .aif-out b { color: var(--blue); font-weight: 600; }
</style>

<script>
  const E = 1.69, A = 406.4, B = 410.7, AL = 0.34, BE = 0.28; // Hoffmann et al. 2022, approach 3 fit
  const CS = [1e18, 1e19, 1e20, 1e21];
  const CL = ['1e18', '1e19', '1e20', '1e21'];
  const NMIN = 7, NMAX = 10.5; // log10 params on the x axis
  const YMIN = 2.2, YMAX = 4.2;
  const X0 = 48, X1 = 548, Y0 = 16, Y1 = 290;
  const NS = 'http://www.w3.org/2000/svg';
  const mk = (tag: string, a: Record<string, string | number>, text?: string) => {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
    if (text) e.textContent = text;
    return e;
  };
  const loss = (N: number, D: number, m: number) => E + A / Math.pow(m * N, AL) + B / Math.pow(D, BE);
  const lossAtC = (N: number, C: number, k: number, m: number) => loss(N, C / (6 * k * N), m);
  const best = (C: number, k: number, m: number) => {
    let bl = Infinity, bn = 0;
    for (let i = 0; i <= 600; i++) {
      const N = Math.pow(10, 5 + i * 0.01);
      const l = lossAtC(N, C, k, m);
      if (l < bl) { bl = l; bn = N; }
    }
    return { l: bl, N: bn };
  };
  const sx = (lg: number) => X0 + ((lg - NMIN) / (NMAX - NMIN)) * (X1 - X0);
  const sy = (l: number) => Y0 + ((YMAX - l) / (YMAX - YMIN)) * (Y1 - Y0);
  const pn = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(1)}B` : `${(n / 1e6).toFixed(0)}M`);

  document.querySelectorAll<HTMLElement>('[data-fig="arch-isoflop"]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const axes = q<SVGGElement>('[data-layer="axes"]');
    const curves = q<SVGGElement>('[data-layer="curves"]');
    const marks = q<SVGGElement>('[data-layer="marks"]');
    const inp = (s: string) => q<HTMLInputElement>(`[data-in="${s}"]`);
    const out = (s: string) => q<HTMLElement>(`[data-out="${s}"]`);

    // axes, drawn once
    axes.appendChild(mk('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, class: 'ink', 'stroke-width': 1 }));
    axes.appendChild(mk('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, class: 'ink', 'stroke-width': 1 }));
    for (let lg = 7; lg <= 10; lg++) {
      axes.appendChild(mk('line', { x1: sx(lg), y1: Y1, x2: sx(lg), y2: Y1 + 4, class: 'ink', 'stroke-width': 1 }));
      axes.appendChild(mk('text', { x: sx(lg), y: Y1 + 16, 'text-anchor': 'middle' }, ['10M', '100M', '1B', '10B'][lg - 7]));
    }
    for (let l = 2.5; l <= 4.01; l += 0.5) {
      axes.appendChild(mk('line', { x1: X0 - 4, y1: sy(l), x2: X0, y2: sy(l), class: 'ink', 'stroke-width': 1 }));
      axes.appendChild(mk('text', { x: X0 - 8, y: sy(l) + 4, 'text-anchor': 'end' }, l.toFixed(1)));
    }
    axes.appendChild(mk('text', { x: X1, y: Y1 + 34, 'text-anchor': 'end' }, 'PARAMETERS N (LOG)'));
    axes.appendChild(mk('text', { x: X0 + 6, y: Y0 + 4 }, 'LOSS'));
    axes.appendChild(mk('line', { x1: X1 - 150, y1: Y0 + 2, x2: X1 - 128, y2: Y0 + 2, class: 'ink', 'stroke-width': 1.5 }));
    axes.appendChild(mk('text', { x: X1 - 122, y: Y0 + 6 }, 'A'));
    axes.appendChild(mk('line', { x1: X1 - 90, y1: Y0 + 2, x2: X1 - 68, y2: Y0 + 2, class: 'blue dash', 'stroke-width': 1.5 }));
    axes.appendChild(mk('text', { x: X1 - 62, y: Y0 + 6, class: 'blue-t' }, 'B'));

    const path = (C: number, k: number, m: number) => {
      let d = '', pen = false;
      for (let i = 0; i <= 140; i++) {
        const lg = NMIN + (i / 140) * (NMAX - NMIN);
        const l = lossAtC(Math.pow(10, lg), C, k, m);
        if (l > YMAX || l < YMIN) { pen = false; continue; }
        d += `${pen ? 'L' : 'M'}${sx(lg).toFixed(1)},${sy(l).toFixed(1)}`;
        pen = true;
      }
      return d;
    };

    const render = () => {
      const ci = +inp('c').value, m = +inp('m').value, k = +inp('k').value;
      const C = CS[ci];
      out('c').textContent = CL[ci]; out('m').textContent = `${m.toFixed(2)}x`; out('k').textContent = `${k.toFixed(1)}x`;
      curves.replaceChildren(); marks.replaceChildren();
      CS.forEach((c, i) => {
        const w = i === ci ? 2 : 0.8;
        const op = i === ci ? '1' : '0.45';
        const a = mk('path', { d: path(c, 1, 1), class: 'ink', 'stroke-width': w });
        a.setAttribute('opacity', op);
        const b = mk('path', { d: path(c, k, m), class: 'blue dash', 'stroke-width': w });
        b.setAttribute('opacity', op);
        curves.appendChild(a); curves.appendChild(b);
        const ba = best(c, 1, 1);
        if (ba.l < YMAX) curves.appendChild(mk('text', { x: Math.min(X1 - 30, sx(Math.log10(ba.N)) + 6), y: sy(ba.l) - 8 }, CL[i]));
      });
      const a = best(C, 1, 1), b = best(C, k, m);
      // equal-FLOP optima
      marks.appendChild(mk('circle', { cx: sx(Math.log10(a.N)), cy: sy(a.l), r: 4.5, class: 'fill-paper', 'stroke-width': 1.5 }));
      marks.appendChild(mk('circle', { cx: sx(Math.log10(b.N)), cy: sy(b.l), r: 4.5, class: 'fill-blue' }));
      // equal params: B at A's N and A's tokens (so B spends k times the FLOPs)
      const D = C / (6 * a.N);
      const lbP = loss(a.N, D, m);
      const sq = mk('rect', { x: sx(Math.log10(a.N)) - 4, y: sy(lbP) - 4, width: 8, height: 8, class: 'fill-wash', 'stroke-width': 1.5 });
      if (lbP > YMIN && lbP < YMAX) marks.appendChild(sq);

      const verdict = (la: number, lb: number) => {
        const dl = lb - la;
        if (Math.abs(dl) < 0.002) return 'tie';
        return dl < 0 ? `<b>B wins</b> by ${(-dl).toFixed(3)}` : `<b>A wins</b> by ${dl.toFixed(3)}`;
      };
      out('eqp').innerHTML = `N = ${pn(a.N)} both. A ${a.l.toFixed(3)}, B ${lbP.toFixed(3)} (square; B spent ${k.toFixed(1)}x the FLOPs) → ${verdict(a.l, lbP)}`;
      out('eqf').innerHTML = `C = ${CL[ci]} both. A ${a.l.toFixed(3)} at ${pn(a.N)}, B ${b.l.toFixed(3)} at ${pn(b.N)} (dots) → ${verdict(a.l, b.l)}`;
      // compute multiplier: what compute would A need to reach B's loss?
      let lo = C / 100, hi = C * 100;
      for (let it = 0; it < 50; it++) {
        const mid = Math.sqrt(lo * hi);
        if (best(mid, 1, 1).l > b.l) lo = mid; else hi = mid;
      }
      out('mult').textContent = `${(Math.sqrt(lo * hi) / C).toFixed(2)}x`;
    };
    ['c', 'm', 'k'].forEach((s) => inp(s).addEventListener('input', render));
    root.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((btn) => btn.addEventListener('click', () => {
      const [m, k] = btn.dataset.p!.split(',');
      inp('m').value = m; inp('k').value = k; render();
    }));
    render();
  });
</script>
