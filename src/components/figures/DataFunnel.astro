---
// Funnel of a real run over the Simple English Wikipedia dump (Oct 2026). Each filter can be
// toggled; the counts for every one of the 64 on/off combinations were precomputed by running
// the actual pipeline (fastText lang ID, length + Gopher-style rules, SHA-1 exact dedup,
// MinHash LSH near-dedup at Jaccard 0.8, 13-gram decontamination against a 1% held-out set).
// Tokens are GPT-2 BPE tokens.
const data = {"base":{"pages":562214,"redirects":115214,"articles":285478,"rawTokens":373235486,"cleanTokens":68517813,"candDocs":283730,"evalDocs":1748},"combos":{"111111":[[279646,67078723],[179083,62738738],[172389,58442557],[172384,58441500],[172328,58429740],[167563,56341571]],"111110":[[279646,67078723],[179083,62738738],[172389,58442557],[172384,58441500],[172328,58429740],[172328,58429740]],"111101":[[279646,67078723],[179083,62738738],[172389,58442557],[172384,58441500],[172384,58441500],[167614,56351878]],"111100":[[279646,67078723],[179083,62738738],[172389,58442557],[172384,58441500],[172384,58441500],[172384,58441500]],"111011":[[279646,67078723],[179083,62738738],[172389,58442557],[172389,58442557],[172328,58429740],[167563,56341571]],"111010":[[279646,67078723],[179083,62738738],[172389,58442557],[172389,58442557],[172328,58429740],[172328,58429740]],"111001":[[279646,67078723],[179083,62738738],[172389,58442557],[172389,58442557],[172389,58442557],[167619,56352935]],"111000":[[279646,67078723],[179083,62738738],[172389,58442557],[172389,58442557],[172389,58442557],[172389,58442557]],"110111":[[279646,67078723],[179083,62738738],[179083,62738738],[179077,62737553],[179021,62725793],[174129,60590594]],"110110":[[279646,67078723],[179083,62738738],[179083,62738738],[179077,62737553],[179021,62725793],[179021,62725793]],"110101":[[279646,67078723],[179083,62738738],[179083,62738738],[179077,62737553],[179077,62737553],[174180,60600901]],"110100":[[279646,67078723],[179083,62738738],[179083,62738738],[179077,62737553],[179077,62737553],[179077,62737553]],"110011":[[279646,67078723],[179083,62738738],[179083,62738738],[179083,62738738],[179021,62725793],[174129,60590594]],"110010":[[279646,67078723],[179083,62738738],[179083,62738738],[179083,62738738],[179021,62725793],[179021,62725793]],"110001":[[279646,67078723],[179083,62738738],[179083,62738738],[179083,62738738],[179083,62738738],[174186,60602086]],"110000":[[279646,67078723],[179083,62738738],[1790