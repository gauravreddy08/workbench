---
// Scheduler timeline: N threads on M cores, CPU-bound or I/O-bound work, GIL on or off.
// A tiny discrete-time simulation: each tick, ready threads get a core (and the GIL, if it exists),
// run one unit of work, and are preempted after a fixed time slice if someone else is waiting.
---
<div class="tsched" data-fig="threads-scheduler">
  <svg viewBox="0 0 640 260" role="img" aria-label="Timeline of threads running, waiting on I/O, or waiting for a core or the GIL"></svg>
  <div class="ctl">
    <label>Threads <input type="range" min="1" max="8" value="4" data-k="n" /> <output data-o="n">4</output></label>
    <label>Cores <input type="range" min="1" max="8" value="4" data-k="m" /> <output data-o="m">4</output></label>
  </div>
  <div class="ctl">
    <span>Work</span>
    <button class="btn" type="button" data-work="cpu" aria-pressed="true">CPU-bound</button>
    <button class="btn" type="button" data-work="io" aria-pressed="false">I/O-bound</button>
    <span>GIL</span>
    <button class="btn" type="button" data-gil aria-pressed="true">GIL on</button>
  </div>
  <p class="tsched-read">
    Wall time <span class="readout" data-r="wall">-</span> ticks ·
    serial <span class="readout" data-r="serial">-</span> ·
    speedup <span class="readout" data-r="speed">-</span> ·
    cores busy <span class="readout" data-r="util">-</span>
  </p>
  <p class="tsched-read" data-r="why"></p>
</div>

<style>
  .tsched-read { font-family: var(--mono); font-size: 12px; color: var(--ink-2); margin: 10px 0 0; line-height: 1.6; }
</style>

<script>
  type State = 'run' | 'ready' | 'wait' | 'done';
  const QUANTUM = 4; // time slice, in ticks
  const JOBS: Record<string, number[]> = {
    // alternating [compute, wait, compute, wait, ..., compute]
    cpu: [24],
    io: [1, 5, 1, 5, 1, 5, 1, 5, 1, 5, 1],
  };
  const NS = 'http://www.w3.org/2000/svg';

  function simulate(n: number, m: number, work: string, gil: boolean) {
    const bursts = JOBS[work];
    const th = Array.from({ length: n }, () => ({ idx: 0, rem: bursts[0], state: 'ready' as State, q: 0 }));
    const queue: number[] = th.map((_, i) => i);
    const hist: State[][] = th.map(() => []);
    const cap = gil ? 1 : m;
    let t = 0;
    let runTicks = 0;
    let gilLimited = 0;
    while (th.some((x) => x.state !== 'done') && t < 2000) {
      // preempt threads whose slice is used up, if someone is waiting
      th.forEach((x, i) => {
        if (x.state === 'run' && x.q >= QUANTUM && queue.length) { x.state = 'ready'; x.q = 0; queue.push(i); }
      });
      let running = th.filter((x) => x.state === 'run').length;
      while (running < cap && queue.length) { const i = queue.shift()!; th[i].state = 'run'; th[i].q = 0; running++; }
      if (gil && queue.length && m > 1) gilLimited++;
      const snap = th.map((x) => x.state);
      snap.forEach((s, i) => hist[i].push(s));
      th.forEach((x, i) => {
        if (snap[i] === 'run') {
          runTicks++; x.rem--; x.q++;
          if (x.rem === 0) {
            x.idx++;
            if (x.idx >= bursts.length) x.state = 'done';
            else { x.state = 'wait'; x.rem = bursts[x.idx]; }
          }
        } else if (snap[i] === 'wait') {
          x.rem--;
          if (x.rem === 0) { x.idx++; x.rem = bursts[x.idx]; x.state = 'ready'; queue.push(i); }
        }
      });
      t++;
    }
    const serial = n * bursts.reduce((a, b) => a + b, 0);
    return { hist, wall: t, serial, util: runTicks / (t * m), gilLimited };
  }

  function el(tag: string, attrs: Record<string, string | number>, text?: string) {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  document.querySelectorAll<HTMLElement>('[data-fig="threads-scheduler"]').forEach((root) => {
    const svg = root.querySelector('svg')!;
    const s = { n: 4, m: 4, work: 'cpu', gil: true };
    const gilBtn = root.querySelector<HTMLButtonElement>('[data-gil]')!;
    const workBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-work]')];
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;

    function draw() {
      const res = simulate(s.n, s.m, s.work, s.gil);
      const X0 = 44, X1 = 628, LANE = 20, GAP = 7, TOP = 30;
      const H = TOP + s.n * (LANE + GAP) + 44;
      svg.setAttribute('viewBox', `0 0 640 ${H}`);
      svg.replaceChildren();
      const scale = (X1 - X0) / res.serial;

      svg.append(el('text', { x: X0, y: 16, class: 'strong' }, 'TIME →'));
      svg.append(el('text', { x: X1, y: 16, 'text-anchor': 'end' }, `SERIAL WOULD END HERE (${res.serial})`));
      svg.append(el('line', { x1: X1, y1: 22, x2: X1, y2: H - 34, class: 'ink dash', 'stroke-width': 1 }));

      res.hist.forEach((lane, i) => {
        const y = TOP + i * (LANE + GAP);
        svg.append(el('text', { x: 0, y: y + 14, class: 'strong' }, `T${i + 1}`));
        svg.append(el('line', { x1: X0, y1: y + LANE / 2, x2: X1, y2: y + LANE / 2, style: 'stroke:var(--rule)', 'stroke-width': 1 }));
        let a = 0;
        while (a < lane.length) {
          let b = a;
          while (b < lane.length && lane[b] === lane[a]) b++;
          const st = lane[a];
          const x = X0 + a * scale, w = Math.max((b - a) * scale - 0.6, 0.8);
          if (st === 'run') svg.append(el('rect', { x, y, width: w, height: LANE, class: 'fill-blue' }));
          else if (st === 'wait') svg.append(el('rect', { x: x + 0.5, y: y + 3.5, width: Math.max(w - 1, 0.5), height: LANE - 7, class: 'blue dash', 'stroke-width': 1 }));
          else if (st === 'ready') svg.append(el('rect', { x, y: y + 6, width: w, height: LANE - 12, style: 'fill:var(--ink-3);opacity:0.45' }));
          a = b;
        }
      });

      const xw = X0 + res.wall * scale;
      svg.append(el('line', { x1: xw, y1: 22, x2: xw, y2: H - 34, class: 'blue', 'stroke-width': 1.5 }));
      const anchor = xw > X1 - 90 ? 'end' : 'start';
      svg.append(el('text', { x: anchor === 'end' ? xw - 4 : xw + 4, y: H - 36, class: 'blue-t', 'text-anchor': anchor }, `DONE @ ${res.wall}`));

      // legend
      const ly = H - 14;
      svg.append(el('rect', { x: 0, y: ly - 9, width: 18, height: 10, class: 'fill-blue' }));
      svg.append(el('text', { x: 24, y: ly }, 'RUNNING PYTHON'));
      svg.append(el('rect', { x: 160, y: ly - 8, width: 18, height: 8, class: 'blue dash', 'stroke-width': 1 }));
      svg.append(el('text', { x: 184, y: ly }, 'WAITING ON I/O'));
      svg.append(el('rect', { x: 316, y: ly - 7, width: 18, height: 6, style: 'fill:var(--ink-3);opacity:0.45' }));
      svg.append(el('text', { x: 340, y: ly }, s.gil ? 'READY, NO CORE OR NO GIL' : 'READY, NO FREE CORE'));

      r('wall').textContent = String(res.wall);
      r('serial').textContent = String(res.serial);
      r('speed').textContent = (res.serial / res.wall).toFixed(1) + 'x';
      r('util').textContent = Math.round(res.util * 100) + '%';

      let why = '';
      if (s.work === 'cpu' && s.gil && s.n > 1) why = s.m > 1 ? 'Every thread wants to compute, but only the GIL holder may run Python. Extra cores sit idle.' : 'One core: threads take turns, no speedup is possible anyway.';
      else if (s.work === 'cpu' && !s.gil) why = s.n > s.m ? 'More threads than cores: the extra ones queue for a core.' : 'Each thread gets its own core. This is parallelism.';
      else if (s.work === 'io') why = 'Waiting needs neither a core nor the GIL, so many threads can wait at once. The GIL barely matters here.';
      else why = 'One thread: nothing to overlap.';
      r('why').textContent = why;
    }

    root.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((inp) => {
      inp.addEventListener('input', () => {
        (s as any)[inp.dataset.k!] = +inp.value;
        root.querySelector<HTMLElement>(`[data-o="${inp.dataset.k}"]`)!.textContent = inp.value;
        draw();
      });
    });
    workBtns.forEach((b) => b.addEventListener('click', () => {
      s.work = b.dataset.work!;
      workBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      draw();
    }));
    gilBtn.addEventListener('click', () => {
      s.gil = !s.gil;
      gilBtn.setAttribute('aria-pressed', String(s.gil));
      gilBtn.textContent = s.gil ? 'GIL on' : 'GIL off';
      draw();
    });
    draw();
  });
</script>
