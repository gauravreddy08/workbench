---
// Success vs number of steps, three ways:
//   no recovery:      p^n
//   with recovery:    q^n, q = p + (1 - p) * r   (a mistake is noticed and fixed in place with prob r)
//   with verification every k steps: each block of k steps is checked. A bad block is caught with
//   prob c and redone (up to M attempts); a missed bad block dooms the run.
//     b = q^k, f = (1 - b) * c, P(block ok) = b * (1 - f^M) / (1 - f), S(n) = P(block ok)^(n / k)
// The closed form was checked against a Monte Carlo simulation (40 steps, p = 0.95: 0.742 vs 0.744).
// Usage: <HorizonCurves />
---
<div class="hzc" data-fig="horizon-curves">
  <div class="ctl">
    <label>p per-step success <input type="range" min="0.80" max="0.995" step="0.005" value="0.95" data-in="p" /> <output data-out="p">0.950</output></label>
    <label>r recovery <input type="range" min="0" max="0.9" step="0.05" value="0" data-in="r" /> <output data-out="r">0.00</output></label>
    <label>verify every <input type="range" min="0" max="5" step="1" value="0" data-in="k" /> <output data-out="k">off</output></label>
    <label>c verifier catch rate <input type="range" min="0.3" max="1" step="0.05" value="0.9" data-in="c" /> <output data-out="c">0.90</output></label>
  </div>

  <svg viewBox="0 0 560 260" role="img" aria-label="Probability of finishing a task against number of steps, on a log scale, for three models of an agent">
    <g data-layer="plot"></g>
  </svg>

  <dl class="hzc-out">
    <div><dt class="label">50% horizon · p^n</dt><dd><span class="readout" data-out="h0">-</span></dd></div>
    <div><dt class="label">50% horizon · recovery</dt><dd><span class="readout" data-out="h1">-</span></dd></div>
    <div><dt class="label">50% horizon · verify</dt><dd><span class="readout big" data-out="h2">-</span></dd></div>
    <div><dt class="label">Success at 10 / 40 / 100</dt><dd><span class="readout" data-out="s">-</span></dd></div>
    <div><dt class="label">Work per finished step</dt><dd><span class="readout" data-out="w">-</span></dd></div>
  </dl>
  <p class="hzc-note" aria-live="polite"></p>
</div>

<style>
  .hzc svg { width: 100%; margin-top: 12px; }
  .hzc-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px 18px; margin: 12px 0 0; }
  .hzc-out div { border-top: 1px solid var(--rule); padding-top: 6px; }
  .hzc-out dt { font-size: 10.5px; }
  .hzc-out dd { margin: 2px 0 0; font-family: var(--mono); font-size: 13px; color: var(--ink-2); }
  .hzc-out .big { font-size: 20px; }
  .hzc-note { margin: 12px 0 0; font-size: 15px; line-height: 1.5; color: var(--ink-2); }
</style>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const mk = (tag: string, a: Record<string, string | number>, text?: string) => {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const KS = [0, 1, 2, 5, 10, 20];
  const M = 3; // attempts per block
  const NMAX = 1000;

  // per-block pass probability and expected attempts
  const block = (q: number, k: number, c: number) => {
    const b = q ** k;
    const f = (1 - b) * c;
    const pass = f < 1 ? (b * (1 - f ** M)) / (1 - f) : b * M;
    const attempts = f < 1 ? (1 - f ** M) / (1 - f) : M;
    return { pass, attempts };
  };
  const horizon = (S: (n: number) => number) => {
    if (S(NMAX) > 0.5) return Infinity;
    let lo = 1, hi = NMAX;
    if (S(lo) < 0.5) return 0.5;
    for (let i = 0; i < 50; i++) { const m = (lo + hi) / 2; if (S(m) >= 0.5) lo = m; else hi = m; }
    return lo;
  };
  const fmtH = (h: number) => (h === Infinity ? `> ${NMAX} steps` : h < 1 ? '< 1 step' : `${h < 10 ? h.toFixed(1) : Math.round(h)} steps`);
  const pct = (x: number) => `${Math.round(100 * x)}%`;

  document.querySelectorAll<HTMLElement>('[data-fig="horizon-curves"]').forEach((root) => {
    const q$ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const inp = (k: string) => q$<HTMLInputElement>(`[data-in="${k}"]`);
    const out = (k: string) => q$<HTMLElement>(`[data-out="${k}"]`);
    const G = q$<SVGGElement>('[data-layer="plot"]');
    const note = q$<HTMLElement>('.hzc-note');

    const render = () => {
      const p = Number(inp('p').value), r = Number(inp('r').value), c = Number(inp('c').value);
      const k = KS[Number(inp('k').value)];
      out('p').textContent = p.toFixed(3);
      out('r').textContent = r.toFixed(2);
      out('k').textContent = k === 0 ? 'off' : `${k} step${k > 1 ? 's' : ''}`;
      out('c').textContent = c.toFixed(2);
      inp('c').disabled = k === 0;

      const q = p + (1 - p) * r;
      const S0 = (n: number) => p ** n;
      const S1 = (n: number) => q ** n;
      const blk = k ? block(q, k, c) : { pass: 1, attempts: 1 };
      const S2 = k ? (n: number) => blk.pass ** (n / k) : S1;

      const x0 = 46, x1 = 540, y0 = 16, y1 = 214;
      const X = (n: number) => x0 + (Math.log10(n) / 3) * (x1 - x0);
      const Y = (s: number) => y1 - s * (y1 - y0);

      G.replaceChildren();
      G.appendChild(mk('line', { x1: x0, y1: y1, x2: x1, y2: y1, class: 'ink', 'stroke-width': 1 }));
      G.appendChild(mk('line', { x1: x0, y1: y0, x2: x0, y2: y1, class: 'ink', 'stroke-width': 1 }));
      [0, 0.25, 0.5, 0.75, 1].forEach((s) => {
        G.appendChild(mk('text', { x: x0 - 8, y: Y(s) + 4, 'text-anchor': 'end' }, `${Math.round(s * 100)}%`));
      });
      G.appendChild(mk('line', { x1: x0, y1: Y(0.5), x2: x1, y2: Y(0.5), class: 'ink dash', 'stroke-width': 0.8 }));
      [1, 3, 10, 30, 100, 300, 1000].forEach((n) => {
        G.appendChild(mk('line', { x1: X(n), y1: y1, x2: X(n), y2: y1 + 4, class: 'ink', 'stroke-width': 1 }));
        G.appendChild(mk('text', { x: X(n), y: y1 + 16, 'text-anchor': 'middle' }, String(n)));
      });
      G.appendChild(mk('text', { x: (x0 + x1) / 2, y: y1 + 34, 'text-anchor': 'middle' }, 'STEPS IN THE TASK (LOG SCALE)'));

      const path = (S: (n: number) => number) => {
        const pts: string[] = [];
        for (let i = 0; i <= 180; i++) { const n = 10 ** ((3 * i) / 180); pts.push(`${X(n).toFixed(1)},${Y(S(n)).toFixed(1)}`); }
        return pts.join(' ');
      };
      G.appendChild(mk('polyline', { points: path(S0), class: 'ink dash', 'stroke-width': 1.2 }));
      if (r > 0) G.appendChild(mk('polyline', { points: path(S1), class: 'ink', 'stroke-width': 1.2 }));
      if (k) G.appendChild(mk('polyline', { points: path(S2), class: 'blue', 'stroke-width': 2 }));

      const h0 = horizon(S0), h1 = horizon(S1), h2 = horizon(S2);
      const dot = (h: number, cls: string) => {
        if (h === Infinity || h < 1) return;
        G.appendChild(mk('circle', { cx: X(h), cy: Y(0.5), r: 4, class: cls, 'stroke-width': 1 }));
      };
      dot(h0, 'fill-paper');
      if (r > 0) dot(h1, 'fill-paper');
      if (k) dot(h2, 'fill-blue');

      // legend
      const lg = [
        ['P^N · NO RECOVERY', 'ink dash', true],
        ['WITH RECOVERY', 'ink', r > 0],
        ['WITH VERIFICATION', 'blue', k > 0],
      ] as const;
      let ly = Y(0.06);
      lg.forEach(([t, cls, on]) => {
        if (!on) return;
        G.appendChild(mk('line', { x1: x1 - 150, y1: ly - 4, x2: x1 - 126, y2: ly - 4, class: cls, 'stroke-width': cls === 'blue' ? 2 : 1.2 }));
        G.appendChild(mk('text', { x: x1 - 120, y: ly }, t));
        ly -= 16;
      });

      out('h0').textContent = fmtH(h0);
      out('h1').textContent = r > 0 ? fmtH(h1) : 'same as p^n';
      out('h2').textContent = k ? fmtH(h2) : 'off';
      out('s').textContent = [10, 40, 100].map((n) => pct(S2(n))).join(' / ');
      // work: steps executed (plus one step-equivalent per check) per useful step, per block
      out('w').textContent = k ? `≈ ${((blk.attempts * (k + 1)) / k).toFixed(2)}×` : '1.00×';

      const e = 1 - p;
      if (k && c < 0.7) note.textContent = `The verifier only catches ${Math.round(c * 100)}% of bad blocks. Every miss is a silent failure, so checking more often barely helps. A weak test suite caps your horizon no matter how often you run it.`;
      else if (k === 1) note.textContent = `Checking after every step: work rises to about ${((blk.attempts * 2)).toFixed(2)}× per step (the check plus redos), but the horizon jumps. This is "run the tests after each edit".`;
      else if (k) note.textContent = `Each block of ${k} steps passes cleanly with q^${k} = ${(q ** k).toFixed(2)}. Bigger blocks are cheaper to check but fail more often and waste more work when redone. Try 1 and 20.`;
      else if (r > 0) note.textContent = `Recovery turns per-step success ${p.toFixed(3)} into an effective ${q.toFixed(3)}. The failure rate falls from ${(e * 100).toFixed(1)}% to ${((1 - q) * 100).toFixed(1)}% per step, and the horizon grows by the same factor.`;
      else note.textContent = `With no recovery the 50% horizon is ln(0.5) / ln(p), which is about 0.69 / (1 - p): ${fmtH(h0)}. Halve the per-step failure rate and the horizon doubles.`;
    };
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', render));
    render();
  });
</script>
