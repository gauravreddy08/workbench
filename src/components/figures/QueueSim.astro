---
// Interactive: producers -> queue -> workers. Jobs arrive at random (Poisson) at the chosen rate;
// each takes 0.25-0.75 s of work (mean 0.5 s). A worker claims a job and holds a lease (visibility
// timeout, 3 s). Kill a worker mid-job and its job sits leased with no owner until the lease runs
// out, then goes back to the head of the queue (redelivery). "Ack before work" shows the other
// choice: the job is deleted on claim, so a kill loses it. Bottom: queue depth (lag) over 60 s.
---
<div class="qs" data-fig="queue-sim">
  <div class="qs-read">
    <div><span class="label">Arrivals</span><span class="readout" data-o="lam"></span></div>
    <div><span class="label">Capacity</span><span class="readout" data-o="cap"></span></div>
    <div><span class="label">In queue</span><span class="readout" data-o="depth"></span></div>
    <div><span class="label">Oldest wait</span><span class="readout" data-o="age"></span></div>
    <div><span class="label">Done</span><span class="readout" data-o="done"></span></div>
    <div><span class="label">Redelivered</span><span class="readout" data-o="redel"></span></div>
    <div><span class="label">Lost</span><span class="readout" data-o="lost"></span></div>
  </div>
  <svg class="qs-main" viewBox="0 0 480 236" role="img" aria-label="Animation of jobs flowing from a producer into a queue and out to workers"></svg>
  <svg class="qs-lag" viewBox="0 0 480 120" role="img" aria-label="Queue depth over the last 60 seconds"></svg>
  <div class="ctl">
    <label>Arrivals / s <input type="range" min="0.5" max="30" step="0.5" value="6" data-k="lam" /><output></output></label>
    <label>Workers <input type="range" min="1" max="16" step="1" value="4" data-k="n" /><output></output></label>
  </div>
  <div class="ctl">
    <button class="btn" type="button" data-act="kill">Kill -9 a worker</button>
    <button class="btn" type="button" data-act="spike">Spike: +60 jobs</button>
    <button class="btn" type="button" data-act="mode" aria-pressed="false">Ack before work</button>
    <button class="btn" type="button" data-act="pause" aria-pressed="false">Pause</button>
  </div>
  <p class="qs-note">Each job takes 0.5 s on average, so one worker does about 2 jobs/s. Lease (visibility timeout) 3 s. A killed worker restarts after 1.5 s. Workers needed by Little's Law: arrivals x 0.5 s.</p>
</div>

<style>
  .qs-read { display: grid; grid-template-columns: repeat(auto-fit, minmax(86px, 1fr)); gap: 10px 14px; border-bottom: 1px solid var(--rule); padding-bottom: 12px; margin-bottom: 10px; }
  .qs-read > div { display: flex; flex-direction: column; gap: 2px; }
  .qs-read .label { font-size: 10px; }
  .qs-read .readout { font-size: 16px; }
  .qs svg { width: 100%; }
  .qs-lag { margin-top: 8px !important; }
  .qs .ctl + .ctl { margin-top: 10px; }
  .qs-note { font-family: var(--mono); font-size: 10.5px; line-height: 1.5; color: var(--ink-3); margin: 12px 0 0; }
</style>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const S_MIN = 0.25, S_MAX = 0.75; // service time range, seconds (mean 0.5)
  const VT = 3; // visibility timeout, s
  const RESPAWN = 1.5; // supervisor restarts a killed worker after this, s
  const HIST = 60; // seconds of lag history

  function el(tag: string, attrs: Record<string, string | number>, text?: string) {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  type Job = { id: number; t0: number; attempts: number };
  type Worker = { state: 'idle' | 'busy' | 'dead'; job?: Job; left: number; total: number; until: number };
  type Orphan = { job: Job; deadline: number };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-fig="queue-sim"]').forEach((root) => {
    const main = root.querySelector<SVGSVGElement>('.qs-main')!;
    const lag = root.querySelector<SVGSVGElement>('.qs-lag')!;
    const lamIn = root.querySelector<HTMLInputElement>('[data-k="lam"]')!;
    const nIn = root.querySelector<HTMLInputElement>('[data-k="n"]')!;
    const btn = (a: string) => root.querySelector<HTMLButtonElement>(`[data-act="${a}"]`)!;
    const out = (k: string) => root.querySelector(`[data-o="${k}"]`)!;

    let t = 0, nextArrival = 0, nextId = 1;
    let queue: Job[] = [];
    let workers: Worker[] = [];
    let orphans: Orphan[] = [];
    let done = 0, redel = 0, lost = 0;
    let ackFirst = false, paused = false, visible = true;
    const hist: { t: number; d: number }[] = [];
    const kills: number[] = [];
    let lastSample = -1;

    const lam = () => +lamIn.value;
    const svc = () => S_MIN + Math.random() * (S_MAX - S_MIN);
    const expo = (rate: number) => -Math.log(1 - Math.random()) / rate;

    function resize() {
      const n = +nIn.value;
      while (workers.length < n) workers.push({ state: 'idle', left: 0, total: 0, until: 0 });
      while (workers.length > n) {
        // retire the last worker gracefully: its job goes back on the queue (it never acked)
        const w = workers.pop()!;
        if (w.state === 'busy' && w.job && !ackFirst) queue.unshift(w.job);
      }
    }

    function step(dt: number) {
      t += dt;
      // arrivals
      while (nextArrival <= t) {
        queue.push({ id: nextId++, t0: nextArrival, attempts: 0 });
        nextArrival += expo(lam());
      }
      // leases that ran out: back to the head of the queue
      orphans = orphans.filter((o) => {
        if (o.deadline <= t) { o.job.attempts++; redel++; queue.unshift(o.job); return false; }
        return true;
      });
      for (const w of workers) {
        if (w.state === 'dead' && t >= w.until) w.state = 'idle';
        if (w.state === 'busy') {
          w.left -= dt;
          if (w.left <= 0) { done++; w.state = 'idle'; w.job = undefined; }
        }
        if (w.state === 'idle' && queue.length) {
          const job = queue.shift()!;
          const s = svc();
          Object.assign(w, { state: 'busy', job, left: s, total: s, until: t + VT });
        }
      }
      if (t - lastSample >= 0.25) {
        lastSample = t;
        hist.push({ t, d: queue.length });
        while (hist.length && hist[0].t < t - HIST) hist.shift();
        while (kills.length && kills[0] < t - HIST) kills.shift();
      }
    }

    function kill() {
      const alive = workers.filter((w) => w.state !== 'dead');
      if (!alive.length) return;
      const busy = alive.filter((w) => w.state === 'busy');
      const w = (busy.length ? busy : alive)[Math.floor(Math.random() * (busy.length || alive.length))];
      if (w.state === 'busy' && w.job) {
        if (ackFirst) lost++;
        else orphans.push({ job: w.job, deadline: w.until });
      }
      Object.assign(w, { state: 'dead', job: undefined, until: t + RESPAWN });
      kills.push(t);
      if (paused || reduce) draw();
    }

    function spike() {
      for (let i = 0; i < 60; i++) queue.push({ id: nextId++, t0: t, attempts: 0 });
      if (paused || reduce) draw();
    }

    const sq = (x: number, y: number, s: number, j: Job) =>
      el('rect', { x, y, width: s, height: s, style: j.attempts ? 'fill:var(--blue);stroke:var(--blue);stroke-width:1' : 'fill:var(--blue-fill);stroke:var(--blue);stroke-width:1' });

    function drawMain() {
      main.replaceChildren();
      const ink = 'stroke:var(--ink);stroke-width:1.2;fill:var(--paper)';
      // producer
      main.appendChild(el('rect', { x: 6, y: 66, width: 62, height: 48, style: ink }));
      main.appendChild(el('text', { x: 37, y: 87, 'text-anchor': 'middle', class: 'strong' }, 'API'));
      main.appendChild(el('text', { x: 37, y: 103, 'text-anchor': 'middle' }, `${lam()}/s`));
      main.appendChild(el('line', { x1: 68, y1: 90, x2: 86, y2: 90, style: 'stroke:var(--ink);stroke-width:1.2' }));
      main.appendChild(el('path', { d: 'M86,86 L92,90 L86,94 Z', style: 'fill:var(--ink)' }));
      // queue: 4 rows x 10 slots, head at the right
      const qx = 94, qy = 52, cell = 14, cols = 10, rows = 5;
      main.appendChild(el('rect', { x: qx - 4, y: qy - 4, width: cols * cell + 6, height: rows * cell + 6, style: 'stroke:var(--ink);stroke-width:1.2;fill:none' }));
      main.appendChild(el('text', { x: qx - 2, y: qy - 12 }, 'QUEUE'));
      main.appendChild(el('text', { x: qx + cols * cell, y: qy - 12, 'text-anchor': 'end' }, 'HEAD →'));
      const shown = Math.min(queue.length, cols * rows);
      for (let i = 0; i < shown; i++) {
        const c = cols - 1 - (i % cols), r = Math.floor(i / cols);
        main.appendChild(sq(qx + c * cell, qy + r * cell, cell - 3, queue[i]));
      }
      if (queue.length > shown) main.appendChild(el('text', { x: qx + cols * cell, y: qy + rows * cell + 16, 'text-anchor': 'end', class: 'blue-t' }, `+${queue.length - shown} MORE`));
      // orphaned leases
      const oy = 160;
      main.appendChild(el('text', { x: qx - 2, y: oy }, 'LEASED, OWNER DEAD'));
      main.appendChild(el('rect', { x: qx - 4, y: oy + 6, width: cols * cell + 6, height: 50, style: 'stroke:var(--ink-3);stroke-width:1;stroke-dasharray:4 4;fill:none' }));
      orphans.slice(0, 5).forEach((o, i) => {
        const x = qx + 2 + i * 28, y = oy + 16;
        main.appendChild(el('rect', { x, y, width: 11, height: 11, style: 'fill:var(--paper);stroke:var(--blue);stroke-width:1;stroke-dasharray:2 2' }));
        main.appendChild(el('text', { x: x + 5.5, y: y + 30, 'text-anchor': 'middle', class: 'blue-t' }, `${Math.max(0, o.deadline - t).toFixed(1)}s`));
      });
      if (!orphans.length) main.appendChild(el('text', { x: qx + 66, y: oy + 36, 'text-anchor': 'middle' }, ackFirst ? 'NONE: ACKED ON CLAIM' : 'NONE'));
      // arrow to workers
      main.appendChild(el('line', { x1: 240, y1: 90, x2: 262, y2: 90, style: 'stroke:var(--ink);stroke-width:1.2' }));
      main.appendChild(el('path', { d: 'M262,86 L268,90 L262,94 Z', style: 'fill:var(--ink)' }));
      // workers: 2 columns x 8
      const wx = 274, wy = 14, ww = 98, wh = 22, gap = 5;
      main.appendChild(el('text', { x: wx, y: 10 }, 'WORKERS'));
      workers.forEach((w, i) => {
        const x = wx + (i >= 8 ? ww + 6 : 0), y = wy + (i % 8) * (wh + gap) + 4;
        if (w.state === 'dead') {
          main.appendChild(el('rect', { x, y, width: ww, height: wh, style: 'fill:none;stroke:var(--ink-3);stroke-width:1;stroke-dasharray:3 3' }));
          main.appendChild(el('text', { x: x + 6, y: y + 15 }, `W${i + 1} KILLED`));
          return;
        }
        main.appendChild(el('rect', { x, y, width: ww, height: wh, style: ink }));
        if (w.state === 'busy' && w.job) {
          const f = 1 - Math.max(0, w.left) / w.total;
          main.appendChild(el('rect', { x: x + 1, y: y + 1, width: (ww - 2) * f, height: wh - 2, style: 'fill:var(--blue-fill);stroke:none' }));
          main.appendChild(sq(x + ww - 15, y + 5.5, 11, w.job));
        }
        main.appendChild(el('text', { x: x + 6, y: y + 15, class: w.state === 'busy' ? 'strong' : '' }, `W${i + 1} ${w.state === 'busy' ? 'BUSY' : 'IDLE'}`));
      });
      // legend
      main.appendChild(el('rect', { x: 6, y: 192, width: 9, height: 9, style: 'fill:var(--blue-fill);stroke:var(--blue);stroke-width:1' }));
      main.appendChild(el('text', { x: 19, y: 200 }, 'NEW'));
      main.appendChild(el('rect', { x: 6, y: 208, width: 9, height: 9, style: 'fill:var(--blue);stroke:var(--blue);stroke-width:1' }));
      main.appendChild(el('text', { x: 19, y: 216 }, 'RETRY'));
    }

    function drawLag() {
      lag.replaceChildren();
      const x0 = 36, x1 = 472, yTop = 16, yBot = 96;
      const maxD = Math.max(10, ...hist.map((h) => h.d));
      const top = Math.ceil(maxD / 10) * 10;
      const X = (tt: number) => x1 - ((t - tt) / HIST) * (x1 - x0);
      const Y = (d: number) => yBot - (d / top) * (yBot - yTop);
      lag.appendChild(el('line', { x1: x0, y1: yBot, x2: x1, y2: yBot, style: 'stroke:var(--ink);stroke-width:1' }));
      lag.appendChild(el('line', { x1: x0, y1: yTop, x2: x0, y2: yBot, style: 'stroke:var(--ink);stroke-width:1' }));
      lag.appendChild(el('text', { x: x0 - 5, y: Y(top) + 4, 'text-anchor': 'end' }, String(top)));
      lag.appendChild(el('text', { x: x0 - 5, y: yBot + 4, 'text-anchor': 'end' }, '0'));
      lag.appendChild(el('text', { x: x0, y: 10 }, 'LAG: JOBS WAITING'));
      lag.appendChild(el('text', { x: x0, y: yBot + 16 }, '-60 s'));
      lag.appendChild(el('text', { x: x1, y: yBot + 16, 'text-anchor': 'end' }, 'NOW'));
      for (const k of kills) {
        const x = X(k);
        lag.appendChild(el('line', { x1: x, y1: yTop, x2: x, y2: yBot, style: 'stroke:var(--ink-3);stroke-width:1;stroke-dasharray:2 3' }));
        lag.appendChild(el('text', { x: x + 2, y: yTop + 8 }, 'KILL'));
      }
      if (hist.length > 1) {
        const d = hist.map((h, i) => `${i ? 'L' : 'M'}${X(h.t).toFixed(1)},${Y(h.d).toFixed(1)}`).join(' ');
        lag.appendChild(el('path', { d: d + ` L${X(hist[hist.length - 1].t).toFixed(1)},${yBot} L${X(hist[0].t).toFixed(1)},${yBot} Z`, style: 'fill:var(--blue-fill);stroke:none;opacity:0.7' }));
        lag.appendChild(el('path', { d, style: 'fill:none;stroke:var(--blue);stroke-width:1.5' }));
      }
    }

    function readouts() {
      const n = workers.length;
      const cap = n / ((S_MIN + S_MAX) / 2);
      out('lam').textContent = `${lam()}/s`;
      out('cap').textContent = `${cap.toFixed(0)}/s`;
      out('depth').textContent = String(queue.length);
      const oldest = queue.reduce((m, j) => Math.min(m, j.t0), Infinity);
      out('age').textContent = queue.length ? `${(t - oldest).toFixed(1)} s` : '0 s';
      out('done').textContent = String(done);
      out('redel').textContent = String(redel);
      out('lost').textContent = String(lost);
      lamIn.nextElementSibling!.textContent = String(lam());
      nIn.nextElementSibling!.textContent = String(n);
    }

    function draw() { drawMain(); drawLag(); readouts(); }

    let last = 0, acc = 0;
    function frame(now: number) {
      const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
      last = now;
      if (!paused && visible) {
        step(dt);
        acc += dt;
        // reduced motion: same simulation, redrawn once a second instead of every frame
        if (!reduce || acc >= 1) { acc = 0; draw(); }
      }
      requestAnimationFrame(frame);
    }

    lamIn.addEventListener('input', () => { nextArrival = t + expo(lam()); readouts(); if (paused) draw(); });
    nIn.addEventListener('input', () => { resize(); draw(); });
    btn('kill').addEventListener('click', kill);
    btn('spike').addEventListener('click', spike);
    btn('mode').addEventListener('click', () => {
      ackFirst = !ackFirst;
      btn('mode').setAttribute('aria-pressed', String(ackFirst));
      draw();
    });
    btn('pause').addEventListener('click', () => {
      paused = !paused;
      btn('pause').setAttribute('aria-pressed', String(paused));
    });
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; last = 0; }).observe(root);

    resize();
    nextArrival = expo(lam());
    draw();
    requestAnimationFrame(frame);
  });
</script>
