# Fish Audio (https://fish.audio → API keys). Voice ids are the model ids of two voices from the
# Fish voice library: A explains, B is the listener.
FISH_API_KEY=
FISH_VOICE_A=
FISH_VOICE_B=
# s2.1-pro-free (free, fair use) or s2.1-pro ($15 per million bytes, about $0.85 per hour of audio)
FISH_MODEL=s2.1-pro-free

# Cloudflare R2 (S3-compatible) for the podcast feed and MP3s.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket, e.g. https://pub-xxxx.r2.dev (no trailing slash)
R2_PUBLIC_BASE=
# Long random folder that keeps the feed unlisted, e.g. the output of: openssl rand -hex 16
R2_PREFIX=
