# Voice provider: elevenlabs (default) or fish
TTS_PROVIDER=elevenlabs

# ElevenLabs Text to Dialogue. eleven_v4_turbo is $0.04 per 1k characters (~$2 per hour of audio),
# eleven_v4 is $0.08. Voices: A explains (Christopher - Friendly, Kind and Raspy), B listens (Mike -
# Natural and Engaging Podcast Host); both are from the shared library and must be added to the account.
ELEVENLABS_API_KEY=
ELEVEN_MODEL=eleven_v4_turbo
ELEVEN_VOICE_A=RPEIZnKMqlQiZyZd1Dae
ELEVEN_VOICE_B=vDchjyOZZytffNeZXfZK

# Fish Audio (https://fish.audio → API keys). Voice ids are the model ids of two voices from the
# Fish voice library: A explains, B is the listener.
FISH_API_KEY=
FISH_VOICE_A=
FISH_VOICE_B=
# s2.1-pro-free (free, fair use), s2.1-pro ($15 per million bytes), or drama-3 (most expressive)
FISH_MODEL=s2.1-pro-free

# Cloudflare R2 (S3-compatible) for the podcast feed and MP3s.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket, e.g. https://pub-xxxx.r2.dev (no trailing slash)
R2_PUBLIC_BASE=
# Long random folder that keeps the feed unlisted, e.g. the output of: openssl rand -hex 16
R2_PREFIX=

# Directory listing. PODCAST_PUBLIC=1 lets Apple Podcasts, Spotify and YouTube list the show; they send
# a verification code to PODCAST_OWNER_EMAIL, which is visible to anyone reading the feed.
PODCAST_PUBLIC=0
PODCAST_OWNER_NAME=
PODCAST_OWNER_EMAIL=
